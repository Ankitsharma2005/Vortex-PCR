<UserControl x:Class="NewsPlay.Desktop.ChannelView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NewsPlay.Desktop" Style="{StaticResource {x:Type UserControl}}">
 <Grid x:Name="OuterLayout"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Border x:Name="OuterBorder" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="3">
 <Grid x:Name="DeckLayout"><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition x:Name="PreviewRow" Height="230"/><RowDefinition Height="20"/><RowDefinition Height="20"/><RowDefinition Height="30"/><RowDefinition Height="32"/><RowDefinition x:Name="TransportRow" Height="0"/></Grid.RowDefinitions>
 <DockPanel><TextBlock x:Name="ChannelTitle" FontSize="13" FontWeight="Bold"/><TextBlock x:Name="StatusBadge" Margin="10,0" FontSize="10"/><TextBlock x:Name="FormatLabel" HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource MutedBrush}"/></DockPanel>
 <Grid x:Name="PreviewLayout" Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="PreviewTransportRow" Height="0"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition x:Name="TimingColumn" Width="145"/></Grid.ColumnDefinitions>
 <Viewbox Margin="0,4,8,4" Stretch="Uniform"><Grid Background="#050911" ClipToBounds="True" x:Name="Monitor" Width="640" Height="360">
    <Image x:Name="Preview" Stretch="Uniform"/>
    <Border x:Name="Slate" Background="#101C2F"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock x:Name="SlateTitle" Text="NEWSPLAY" FontSize="25" FontWeight="Bold" Foreground="#BACCE8" HorizontalAlignment="Center"/><TextBlock x:Name="SlateSubtitle" Text="READY WHEN YOU ARE" Foreground="#6C87AC" FontSize="10" Margin="0,12,0,0" HorizontalAlignment="Center"/></StackPanel></Border>
    <TextBlock Text="NATIVE SOFTWARE PREVIEW" FontSize="8" Foreground="#91A9C9" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"/>
    <Border x:Name="LogoBox" Background="#C22D44" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20,15" Padding="8,4"><TextBlock x:Name="LogoText" Text="NEWSPLAY" FontSize="13" FontWeight="Bold" Foreground="White"/></Border>
    <Border x:Name="LowerBox" Background="#E6192A44" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24,0,20,39" Padding="10,7" BorderBrush="#EF526C" BorderThickness="3,0,0,0"><StackPanel><TextBlock x:Name="Headline" FontSize="18" FontWeight="SemiBold" MaxWidth="440" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="Subtitle" FontSize="10" Foreground="#AFC0D9" Margin="0,3,0,0"/></StackPanel></Border>
    <Border x:Name="TickerBox" Height="23" VerticalAlignment="Bottom" Margin="0,0,0,9" Background="#BB283C" ClipToBounds="True"><Canvas><TextBlock x:Name="TickerText" FontSize="12" Foreground="White" Canvas.Top="3"/></Canvas></Border>
    <TextBlock x:Name="PreviewClock" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10,0,20,40" Background="#B5101929" FontFamily="Consolas" FontSize="11" Padding="5,3"/>
    <Border x:Name="SafeArea" Margin="40,19" BorderBrush="#667D92B1" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False"/>
   </Grid></Viewbox>
 <local:StereoMeter x:Name="PortMeter" Grid.Column="1" Margin="1,4,7,4"/>
 <StackPanel Grid.Column="2" Margin="6,8,0,0"><TextBlock Text="DURATION" FontSize="10" Foreground="{StaticResource MutedBrush}"/><local:DigitalReadout x:Name="DurationText" FontFamily="Consolas" FontSize="24" FontWeight="Bold" Foreground="#CED2D8"/><TextBlock Text="ELAPSED" FontSize="10" Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}"/><local:DigitalReadout x:Name="ElapsedText" FontFamily="Consolas" FontSize="24" FontWeight="Bold" Foreground="#72D17C"/><TextBlock Text="REMAINING" FontSize="10" Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}"/><Border x:Name="RemainingBackground" CornerRadius="5" Padding="3" Background="#182330"><local:DigitalReadout x:Name="RemainingText" FontFamily="Consolas" FontSize="24" FontWeight="Bold" Foreground="#F18A8A"/></Border><TextBlock x:Name="DecoderLabel" FontSize="9" Margin="0,14,0,0" Foreground="{StaticResource MutedBrush}"/><Button x:Name="AutoButton" Visibility="Collapsed" Tag="AutoAdvance" Click="ListAction"/></StackPanel>
 </Grid>
 <DockPanel Grid.Row="2" Background="#172B28"><TextBlock Text="NOW  " Foreground="#BFC4BB" FontSize="10"/><TextBlock x:Name="NowTitle" Foreground="#87DA86" TextTrimming="CharacterEllipsis" FontSize="10"/></DockPanel>
 <TextBlock Grid.Row="3" x:Name="NextText" Foreground="#D8C97D" FontSize="10" TextTrimming="CharacterEllipsis"/>
 <DockPanel Grid.Row="4"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><CheckBox x:Name="MuteCheck" Content="Mute" Click="MuteClicked" FontSize="10"/><Slider x:Name="GainSlider" Width="48" Minimum="-60" Maximum="12" PreviewMouseLeftButtonUp="GainReleased" Margin="3"/><TextBlock x:Name="GainLabel" FontSize="9" Width="32"/><ComboBox x:Name="EndMode" Width="65" SelectionChanged="EndChanged" ToolTip="Behavior at end of clip"><ComboBoxItem Content="Auto"/><ComboBoxItem Content="Hold"/><ComboBoxItem Content="Black"/></ComboBox></StackPanel><Slider x:Name="PositionSlider" Minimum="0" Maximum="1" PreviewMouseLeftButtonUp="SeekReleased" Margin="5"/></DockPanel>
 <Border x:Name="TransportPanel" Grid.Row="6" Background="#111A25" CornerRadius="7" Padding="3" Margin="0,4,0,0">
 <UniformGrid x:Name="TransportButtons" Rows="1" Columns="6">
 <UniformGrid.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Height" Value="48"/><Setter Property="MinWidth" Value="48"/><Setter Property="FontSize" Value="25"/><Setter Property="FontFamily" Value="Segoe UI Symbol"/><Setter Property="Padding" Value="4"/><Setter Property="Margin" Value="3"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style></UniformGrid.Resources>
 <Button Content="⏮" Tag="Previous" Click="Transport" ToolTip="Previous clip"/>
 <Button x:Name="PlayPauseButton" Content="▶" Tag="PlayPause" Click="IconTransport" ToolTip="Play / Pause" Background="#23775C"/>
 <Button Content="⏭" Tag="Next" Click="Transport" ToolTip="Next clip"/>
 <Button Content="↻" Tag="Repeat" Click="IconTransport" ToolTip="Restart current clip"/>
 <Button x:Name="LoopIcon" Content="∞" Tag="Loop" Click="IconTransport" ToolTip="Loop current clip"/>
 <Button Content="■" Tag="Stop" Click="Transport" ToolTip="Stop" Foreground="#FF9EAA"/>
 </UniformGrid></Border>
 <Grid Grid.Row="5" Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="AutoBarButton" Content="AUTO" Tag="AutoAdvance" Click="ListAction" Padding="6,2"/><Grid Grid.Column="1" Margin="4,2"><ProgressBar x:Name="AutoProgress" Minimum="0" Maximum="100" Height="24" Background="#22252C" Foreground="#30734D"/><TextBlock x:Name="AutoProgressText" FontSize="10" HorizontalAlignment="Center" Foreground="White" TextTrimming="CharacterEllipsis"/></Grid></Grid>
 </Grid></Border>
 <Grid x:Name="RundownPanel" Grid.Row="1" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition/><RowDefinition Height="34"/></Grid.RowDefinitions>
 <DockPanel Grid.Row="0"><ComboBox x:Name="RundownSelect" DisplayMemberPath="Name" SelectedValuePath="Id" MinWidth="190" MaxWidth="300" SelectionChanged="RundownChanged"/><Button Content="＋" Tag="Rundown.Create" Click="ListAction" ToolTip="New rundown"/><Button Content="Copy" Tag="Rundown.Duplicate" Click="ListAction"/><Button Content="Rename" Tag="Rundown.Rename" Click="ListAction"/><Button Content="↓" Tag="Export" Click="ListAction" ToolTip="Export rundown"/><Button Content="↑" Tag="Import" Click="ListAction" ToolTip="Import rundown"/><CheckBox x:Name="LoopClip" Content="Loop clip" ToolTip="Repeat only this clip until you play another" Click="LoopClipClicked"/><CheckBox x:Name="LoopList" Content="Loop playback" ToolTip="Repeat whichever clip is currently playing. Play Now on another clip to repeat that clip instead." Click="LoopPlaybackClicked" HorizontalAlignment="Right"/></DockPanel>
 <DataGrid x:Name="RundownGrid" Grid.Row="1" RowHeight="26" SelectionMode="Extended" MouseDoubleClick="EditDoubleClick" SelectionChanged="ItemSelected" PreviewMouseMove="BeginDrag">
 <DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers>
 <DataTrigger Binding="{Binding Status}" Value="PLAYING"><Setter Property="Background" Value="#278B3A"/><Setter Property="Foreground" Value="White"/></DataTrigger>
 <DataTrigger Binding="{Binding Status}" Value="CUED"><Setter Property="Background" Value="#8B791F"/><Setter Property="Foreground" Value="White"/></DataTrigger>
 <DataTrigger Binding="{Binding Status}" Value="NEXT"><Setter Property="Background" Value="#6E6125"/><Setter Property="Foreground" Value="#FFF4BB"/></DataTrigger>
 <DataTrigger Binding="{Binding Status}" Value="MISSING / INVALID"><Setter Property="Background" Value="#71323A"/><Setter Property="Foreground" Value="#FFE1E1"/></DataTrigger>
 </Style.Triggers></Style></DataGrid.RowStyle>
 <DataGrid.Columns><DataGridTextColumn Header="CLIP NAME / STORY" Binding="{Binding Title}" Width="2*" MinWidth="160"/><DataGridTextColumn Header="CLIP ID" Binding="{Binding MediaId}" Width="100"/><DataGridTextColumn Header="DURATION" Binding="{Binding DurationText}" Width="90"/><DataGridTextColumn Header="MARK IN" Binding="{Binding InText}" Width="90"/><DataGridTextColumn Header="MODE" Binding="{Binding StartMode}" Width="65"/><DataGridTextColumn Header="LOOP" Binding="{Binding LoopText}" Width="45"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="115"/><DataGridTextColumn Header="REPORTER" Binding="{Binding Reporter}" Width="95"/><DataGridTextColumn Header="COMMENTS" Binding="{Binding Notes}" Width="*" MinWidth="90"/></DataGrid.Columns>
 </DataGrid>
 <DockPanel Grid.Row="2"><StackPanel Orientation="Horizontal"><Button x:Name="LockButton" Content="Lock" Tag="Rundown.Lock" Click="ListAction"/><Button x:Name="PreflightButton" Content="Check media" Tag="Preflight" Click="ListAction"/><Button Content="Trim / properties" Tag="Edit" Click="ListAction"/><Button Content="↑" Tag="Up" Click="ListAction"/><Button Content="↓" Tag="Down" Click="ListAction"/><Button Content="Remove" Tag="Rundown.Remove" Click="ListAction"/><Button Content="Undo" Tag="Rundown.Undo" Click="ListAction"/><Button Content="Redo" Tag="Rundown.Redo" Click="ListAction"/><Button Content="Break loop" Tag="BreakLoop" Click="Transport"/></StackPanel><TextBlock x:Name="TotalText" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="#79B8E7" FontSize="14" Margin="8,0"/></DockPanel>
 </Grid></Grid>
</UserControl>



